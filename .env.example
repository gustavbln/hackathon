# Copy to .env. These settings are server-only.
# Required: create a key at https://tokenfactory.nebius.com/.
NEBIUS_API_KEY=

# Exact model ID verified against Nebius's authenticated /v1/models endpoint.
NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional: Tavily web search for the planned real-company research agent.
# Create a key at https://app.tavily.com/.
TAVILY_API_KEY=
